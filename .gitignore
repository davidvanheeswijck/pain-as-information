# Secrets. Never commit a key. .env is where they live and it is never tracked.
.env
.env.*
!.env.example

# Names used by the privacy backstop. Local only, by design: a list of the
# people whose names must not appear is itself the thing you would not want in
# a public repository.
tools/.privacy-names

# Caches
.citation-cache.json
__pycache__/
*.pyc
.DS_Store

# Case material never enters this repository. This line is a backstop for a
# mistake, not a place to put things. See ETHICS.md.
case/
private/
*.dcm

# Simulation virtualenv. simulations/ is deliberately outside the stdlib-only
# rule that governs tools/, so it has dependencies; they are not committed.
simulations/.venv/

# Compiled NEURON artefacts (nrnivmodl output) for simulations/S-001-*/mod/
simulations/**/arm64/
simulations/**/x86_64/
simulations/**/aarch64/
simulations/**/*.o
simulations/**/*.dylib
simulations/**/*.so
simulations/**/mod/*.c
simulations/**/mod/*.cpp
# Smoke-test output; never a result
simulations/**/results/pilot/
# S-1 per-model working files of the main run (resumable); committed as per-model-files.zip instead
simulations/**/results/main/cand/
simulations/**/results/main/model/
simulations/**/results/main/stoch/
simulations/**/results/main/tests/
simulations/**/results/main/ab/
simulations/**/results/main/converge/
simulations/**/results/main/tuning/
simulations/**/results/main/val/
