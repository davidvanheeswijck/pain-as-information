# Copy to .env at the repository root. .env is gitignored; never commit a real
# key, and never paste one into an issue, a commit message or a chat.

# Routing key: may call completions. This is the one the harness uses.
REQUESTY_API_KEY=

# Management key: may mint keys. Deliberately separate, so that a leaked
# routing key cannot create more keys. Only needed by tools/new-requesty-key.sh.
# REQUESTY_MANAGE_KEY=

# --- routing -----------------------------------------------------------
# EU-hosted, zero-retention by default. Pinning the EU base URL alone is NOT
# enough: Requesty's own documentation says the EU endpoint guarantees only
# that their processing stays in the EU, and the model must also be an EU
# model. The runner checks both, per model, at request time. A config typo
# that sends you to a US endpoint produces no error, only different routing,
# which is why this is verified rather than configured.
# REVIEW_BASE_URL=https://router.eu.requesty.ai/v1
# REVIEW_MODEL=vertex/gemini-3.7-flash@eu

# Three separate guarantees, three separate switches, so that relaxing one does
# not silently drop the other two. Unknown fails closed: a router that does not
# report a field is refused rather than read as a quiet yes.
# REVIEW_REQUIRE_EU=1
# REVIEW_REQUIRE_NO_TRAINING=1
# REVIEW_REQUIRE_ZDR=1

# Skip verification entirely. The verdict record then claims nothing about
# jurisdiction, because nothing was checked.
# REVIEW_VERIFY=1

# Some reasoning-tier models reject `temperature` outright. The runner drops it
# automatically on that error; set to "off" to never send it.
# REVIEW_TEMPERATURE=0.3

# --- citation verification ---------------------------------------------
# Crossref and NCBI both ask for a contact address and give politer service to
# clients that send one. NCBI raises the rate limit from 3/s to 10/s with a
# free key.
# CROSSREF_MAILTO=you@example.org
# NCBI_API_KEY=
